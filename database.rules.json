{
  "rules": {
    ".read": false,
    ".write": false,
    "ritmo": {
      "users": {
        "$uid": {
          "workspace": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && newData.exists()",
            ".validate": "newData.hasChildren(['payload', 'revision', 'updatedAt']) && ((!data.exists() && newData.child('revision').val() === 1) || (data.exists() && newData.child('revision').val() === data.child('revision').val() + 1)) && newData.child('updatedAt').val() === now",
            "payload": {
              ".validate": "newData.isString() && newData.val().length <= 2000000"
            },
            "revision": {
              ".validate": "newData.isNumber() && newData.val() >= 1"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
  