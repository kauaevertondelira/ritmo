{
  "name": "ritmo-pessoal",
  "version": "1.1.0",
  "private": true,
  "description": "Organização pessoal com Firebase e publicação no GitHub Pages",
  "scripts": {
    "start": "node serve.mjs",
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/build.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && node scripts/android-apk.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "esbuild": "0.28.2",
    "esbuild-wasm": "0.28.2",
    "sharp": "0.34.5"
  }
}
